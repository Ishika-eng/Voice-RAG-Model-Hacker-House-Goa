# --- Speech-to-text (pick Sarvam; ElevenLabs left as an alt path in src/stt.py) ---
SARVAM_API_KEY=

# --- Answer generation (Groq: free tier, fast inference) ---
GROQ_API_KEY=
GENERATION_MODEL=openai/gpt-oss-120b

# --- Embeddings / retrieval ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
QDRANT_PATH=./data/qdrant_local
TOP_K=5

# --- Dataset ---
HF_DATASET=ai4bharat/MSMARCO-XI
HF_DATASET_LANG=hin
INGEST_LIMIT=20000

# --- Guardrails ---
OFFTOPIC_SIM_THRESHOLD=0.72
GROUNDEDNESS_OVERLAP_THRESHOLD=0.20
